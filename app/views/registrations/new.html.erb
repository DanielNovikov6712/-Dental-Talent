<% content_for :title, "Create your account" %>

<div class="card card--narrow">
  <h1>Create your account</h1>
  <p class="lead">Start your candidate profile in two quick steps.</p>

  <%= form_with model: @user, url: registration_path do |form| %>
    <%= render "shared/error_summary", record: @user %>

    <div class="field">
      <%= form.label :email_address, "Email" %>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username" %>
    </div>
    <div class="field">
      <%= form.label :password %>
      <%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 72 %>
      <p class="hint">At least 8 characters.</p>
    </div>
    <div class="field">
      <%= form.label :password_confirmation, "Confirm password" %>
      <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72 %>
    </div>

    <div class="btn-row">
      <%= form.submit "Create account", class: "btn btn--primary" %>
      <%= link_to "I already have an account", new_session_path, class: "nav-link" %>
    </div>
  <% end %>
</div>
