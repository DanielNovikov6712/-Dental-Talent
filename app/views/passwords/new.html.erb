<% content_for :title, "Reset password" %>

<div class="card card--narrow">
  <h1>Forgot your password?</h1>
  <p class="lead">Enter your email and we'll send reset instructions.</p>

  <%= form_with url: passwords_path do |form| %>
    <div class="field">
      <%= form.label :email_address, "Email" %>
      <%= form.email_field :email_address, required: true, autofocus: true,
            autocomplete: "username", value: params[:email_address] %>
    </div>
    <div class="btn-row">
      <%= form.submit "Email reset instructions", class: "btn btn--primary" %>
      <%= link_to "Back to sign in", new_session_path, class: "nav-link" %>
    </div>
  <% end %>
</div>
