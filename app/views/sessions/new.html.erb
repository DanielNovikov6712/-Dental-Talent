<% content_for :title, "Sign in" %>

<div class="card card--narrow">
  <h1>Sign in</h1>
  <p class="lead">Welcome back. Sign in to continue your onboarding.</p>

  <%= form_with url: session_path do |form| %>
    <div class="field">
      <%= form.label :email_address, "Email" %>
      <%= form.email_field :email_address, required: true, autofocus: true,
            autocomplete: "username", value: params[:email_address] %>
    </div>
    <div class="field">
      <%= form.label :password %>
      <%= form.password_field :password, required: true,
            autocomplete: "current-password", maxlength: 72 %>
    </div>
    <div class="btn-row">
      <%= form.submit "Sign in", class: "btn btn--primary" %>
      <%= link_to "Forgot password?", new_password_path, class: "nav-link" %>
    </div>
  <% end %>

  <p class="muted" style="margin-top:1.25rem">
    New candidate? <%= link_to "Create an account", new_registration_path %>.
  </p>
</div>
