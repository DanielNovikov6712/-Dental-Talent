<section class="card">
  <h2>Additional information</h2>

  <div class="field">
    <%= form.label :professional_summary do %>Professional summary <%= profile_field_badge(profile, :professional_summary) %><% end %>
    <%= form.text_area :professional_summary, rows: 4 %>
    <p class="hint">A short summary employers will see. You can edit or rewrite it.</p>
  </div>

  <div class="field">
    <%= form.label :motivation, "Motivation for employer" %>
    <%= form.text_area :motivation, rows: 3 %>
  </div>
</section>
