<section class="card">
  <h2>Employment &amp; compensation</h2>

  <fieldset class="field">
    <legend>Desired employment type <%= profile_field_badge(profile, :employment_types, required: true) %></legend>
    <%= multiselect_checkboxes(profile, :employment_types, Constants::EMPLOYMENT_TYPES,
          input_data: { conditional_fields_target: "employment", action: "change->conditional-fields#update" }) %>
  </fieldset>

  <div class="grid-2">
    <div class="field">
      <%= form.label :years_of_experience do %>Years of combined dental experience <%= profile_field_badge(profile, :years_of_experience, required: true) %><% end %>
      <%= form.number_field :years_of_experience, min: 0 %>
    </div>

    <div class="field section-fields" data-conditional-fields-target="group"
         data-visible-employment="<%= Constants::SALARY_EMPLOYMENT_TYPES.join(' ') %>">
      <%= form.label :desired_gross_salary, "Desired gross monthly salary (€)" %>
      <%= form.number_field :desired_gross_salary, min: 0 %>
    </div>

    <div class="field section-fields" data-conditional-fields-target="group"
         data-visible-employment="<%= Constants::PERCENTAGE_EMPLOYMENT_TYPES.join(' ') %>">
      <%= form.label :desired_percentage, "Desired percentage (%)" %>
      <%= form.number_field :desired_percentage, min: 0, max: 100, step: 0.5 %>
    </div>

    <div class="field section-fields" data-conditional-fields-target="group"
         data-visible-functions="<%= Constants::REVENUE_FUNCTIONS.join(' ') %>">
      <%= form.label :average_daily_revenue, "Average daily revenue (€)" %>
      <%= form.number_field :average_daily_revenue, min: 0 %>
    </div>
  </div>

  <div class="section-fields" data-conditional-fields-target="group"
       data-visible-functions="<%= Constants::BIG_REGISTRATION_FUNCTIONS.join(' ') %>">
    <div class="grid-2">
      <div class="field">
        <%= form.label :big_registration_status, "BIG registration status" %>
        <%= form.select :big_registration_status,
              option_choices(Constants::BIG_REGISTRATION_STATUSES),
              { include_blank: "Select status" },
              { data: { conditional_fields_target: "bigStatus", action: "change->conditional-fields#update" } } %>
      </div>
      <div class="field section-fields" data-conditional-fields-target="group"
           data-visible-big-status="<%= Constants::BIG_REGISTERED_STATUS %>">
        <%= form.label :big_number do %>BIG number <%= profile_field_badge(profile, :big_number) %><% end %>
        <%= form.text_field :big_number %>
        <p class="hint">Required when your BIG status is "BIG registered".</p>
      </div>
    </div>
  </div>
</section>
