<% skills_by_group = Skill.ordered.group_by(&:function_group)
   active_group = profile.skill_group
   selected_skill_ids = @selected_skill_ids || profile.skill_ids %>

<section class="card">
  <h2>Skills <%= profile_field_badge(profile, :skills) %></h2>
  <p class="hint">The available skills depend on your selected job function.</p>

  <p class="muted" data-conditional-fields-target="skillPrompt" <%= "hidden" if active_group %>>
    Select a job function above to see the relevant skills.
  </p>

  <% Constants::SKILL_GROUPS.each_key do |group| %>
    <div class="section-fields" data-conditional-fields-target="skillGroup"
         data-skill-group="<%= group %>" <%= "hidden" unless group == active_group %>>
      <div class="check-grid">
        <% (skills_by_group[group] || []).each do |skill| %>
          <label class="check">
            <%= check_box_tag "skill_ids[]", skill.id, selected_skill_ids.include?(skill.id), id: "skill_#{skill.id}" %>
            <%= skill.name %>
          </label>
        <% end %>
      </div>
    </div>
  <% end %>

  <div class="field" style="margin-top:1rem">
    <%= label_tag :suggested_skills, "Other skills (comma separated)" %>
    <%= text_area_tag :suggested_skills,
          @suggested_skills || profile.candidate_skills.suggestions.map(&:name).join(", "),
          rows: 2, placeholder: "Any skills not listed above" %>
    <p class="hint">These are kept as suggestions for our recruitment team to review.</p>
  </div>
</section>
