<div class="repeater-item" data-nested-form-target="item">
  <% if f.object.persisted? %><%= f.hidden_field :_destroy %><% end %>

  <div class="grid-2">
    <div class="field">
      <%= f.label :job_title %>
      <%= f.text_field :job_title %>
    </div>
    <div class="field">
      <%= f.label :company_name %>
      <%= f.text_field :company_name %>
    </div>
  </div>

  <div class="field">
    <%= f.label :responsibilities %>
    <%= f.text_area :responsibilities, rows: 3 %>
  </div>

  <div class="grid-2">
    <div class="field">
      <%= f.label :start_date %>
      <%= f.date_field :start_date %>
    </div>
    <div class="field">
      <%= f.label :end_date %>
      <%= f.date_field :end_date %>
    </div>
  </div>

  <label class="check">
    <%= f.check_box :current %>
    This is my current job
  </label>

  <button type="button" class="btn--danger-link repeater-item__remove" data-action="nested-form#remove">Remove</button>
</div>
