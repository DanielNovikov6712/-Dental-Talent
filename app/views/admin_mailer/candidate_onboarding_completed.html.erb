<h1>New candidate profile completed</h1>

<p>A candidate has just completed onboarding:</p>

<ul>
  <li><strong>Name:</strong> <%= @name %></li>
  <li><strong>Email:</strong> <%= @profile.email %></li>
  <li><strong>Function:</strong> <%= @function %></li>
  <li><strong>City:</strong> <%= @profile.city %></li>
  <li><strong>Experience:</strong> <%= @profile.years_of_experience %> years</li>
</ul>

<p>
  <%= link_to "View the full profile", admin_candidate_profile_url(@profile) %>
</p>
